# OpenAI-compatible endpoint. Defaults match Ollama on this Mac: ollama/README.md
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=qwen3.5:4b
# Completion budget shared by final content and provider reasoning.
OPENAI_MAX_TOKENS=4096
# Standard OpenAI-compatible control. Leave empty to omit it for providers that do not support it.
OPENAI_REASONING_EFFORT=none
